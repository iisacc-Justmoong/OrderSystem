    {
      "id": "b000001",
      "kind": "heading",
      "start_line": 1,
      "end_line": 1,
      "raw": "# Retail Order System\n",
      "level": 1,
      "title": "Retail Order System"
    },
    {
      "id": "b000002",
      "kind": "blank",
      "start_line": 2,
      "end_line": 2,
      "raw": "\n"
    },
    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 3,
      "raw": "ASP . NET  Core Web  API  project to verify the sleeve order processing workflow. It focuses on order data integrity such as order creation, inventory deduction, status transition, payment ledger, and inventory restoration upon cancellation, rather than the shopping mall screen.\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
      "start_line": 4,
      "end_line": 4,
      "raw": "\n"
    },
    {
