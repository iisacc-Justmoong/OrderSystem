    },
    {
      "id": "b000053",
      "kind": "fenced_code",
      "start_line": 84,
      "end_line": 98,
      "raw": "```json\n{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"productId\": 10,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 15,\n      \"quantity\": 1\n    }\n  ]\n}\n```\n",
      "language": "json",
      "code": "{\n  \"customerId\": 1,\n  \"items\": [\n    {\n      \"productId\": 10,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 15,\n      \"quantity\": 1\n    }\n  ]\n}\n",
      "closed": true
    },
    {
      "id": "b000054",
      "kind": "blank",
      "start_line": 99,
      "end_line": 99,
      "raw": "\n"
    },
    {
      "id": "b000055",
      "kind": "paragraph",
      "start_line": 100,
      "end_line": 100,
      "raw": "The server does not use the price sent by the client but calculates `UnitPrice`, `LineTotal`, and `TotalAmount` using the product price stored in the DB.\n"
    },
    {
      "id": "b000056",
      "kind": "blank",
      "start_line": 101,
      "end_line": 101,
      "raw": "\n"
    },
