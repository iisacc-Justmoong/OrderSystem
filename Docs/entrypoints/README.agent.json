    {
      "id": "b000065",
      "kind": "paragraph",
      "start_line": 114,
      "end_line": 114,
      "raw": "If only the Rider bundle SDK is available in the current development environment, specify the corresponding `dotnet` executable directly.\n"
    },
    {
      "id": "b000066",
      "kind": "blank",
      "start_line": 115,
      "end_line": 115,
      "raw": "\n"
    },
    {
      "id": "b000067",
      "kind": "fenced_code",
      "start_line": 116,
      "end_line": 120,
      "raw": "```bash\n/Applications/Rider.app/Contents/lib/ReSharperHost/macos-arm64/dotnet/dotnet restore OrderSystem.sln\n/Applications/Rider.app/Contents/lib/ReSharperHost/macos-arm64/dotnet/dotnet test OrderSystem.sln\n/Applications/Rider.app/Contents/lib/ReSharperHost/macos-arm64/dotnet/dotnet build OrderSystem.sln\n```\n",
      "language": "bash",
      "code": "/Applications/Rider.app/Contents/lib/ReSharperHost/macos-arm64/dotnet/dotnet restore OrderSystem.sln\n/Applications/Rider.app/Contents/lib/ReSharperHost/macos-arm64/dotnet/dotnet test OrderSystem.sln\n/Applications/Rider.app/Contents/lib/ReSharperHost/macos-arm64/dotnet/dotnet build OrderSystem.sln\n",
      "closed": true
    },
    {
      "id": "b000068",
